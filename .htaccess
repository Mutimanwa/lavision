# # LaVision - Configuration Apache
# # Système de gestion scolaire

# # Activer la réécriture d'URL
# RewriteEngine On

# # Forcer HTTPS (décommenter si nécessaire)
# # RewriteCond %{HTTPS} off
# # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# # Rediriger les URLs avec www vers sans www (optionnel)
# # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
# # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# # Protéger les fichiers sensibles
# <FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak|sql)$">
#     Order Allow,Deny
#     Deny from all
# </FilesMatch>

# # Protéger le répertoire src (code source)
# <Directory "src/">
#     Order Allow,Deny
#     Deny from all
# </Directory>

# # Protéger les logs
# <Directory "logs/">
#     Order Allow,Deny
#     Deny from all
# </Directory>

# # Protéger les backups
# <Directory "backups/">
#     Order Allow,Deny
#     Deny from all
# </Directory>

# # Autoriser l'accès aux assets publics
# <Directory "public/assets/">
#     Options -Indexes
#     AllowOverride None
#     Require all granted
# </Directory>

# # Autoriser l'accès aux uploads (avec restrictions)
# <Directory "public/uploads/">
#     Options -Indexes
#     AllowOverride None
#     Require all granted

#     # Désactiver l'exécution de scripts PHP dans uploads
#     <Files *.php>
#         Order Allow,Deny
#         Deny from all
#     </Files>

#     php_flag engine off
# </Directory>

# # Configuration PHP pour les uploads
# php_value upload_max_filesize 10M
# php_value post_max_size 12M
# php_value max_execution_time 300
# php_value memory_limit 256M

# # Configuration de sécurité
# <IfModule mod_headers.c>
#     # Sécurité des headers
#     Header always set X-Content-Type-Options nosniff
#     Header always set X-Frame-Options DENY
#     Header always set X-XSS-Protection "1; mode=block"
#     Header always set Referrer-Policy "strict-origin-when-cross-origin"

#     # Cache des assets statiques
#     <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
#         Header set Cache-Control "max-age=31536000, public"
#     </FilesMatch>

#     # Pas de cache pour les pages dynamiques
#     <FilesMatch "\.(php|html)$">
#         Header set Cache-Control "no-cache, no-store, must-revalidate"
#         Header set Pragma "no-cache"
#         Header set Expires 0
#     </FilesMatch>
# </IfModule>

