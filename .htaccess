# Activer la réécriture d'URL
RewriteEngine On

# Redirection vers index.php sauf fichiers existants
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Protection des fichiers sensibles
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak|sql)$">
    Require all denied
</FilesMatch>

# Désactiver l'exécution PHP dans /uploads
<FilesMatch "uploads/.*\.php$">
    Require all denied
</FilesMatch>

# Headers de sécurité
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Bloquer fichiers sensibles via rewrite
RewriteRule ^(.+)\.(sql|bak|old)$ - [F,L]
RewriteRule ^\.git - [F,L]
RewriteRule ^\.env - [F,L]

# Blocage scanners
RewriteCond %{QUERY_STRING} (\|%3B|<|>|'|"|\)|\(|%22|%27|%28|%29) [NC,OR]
RewriteCond %{QUERY_STRING} (javascript:|\.\./|\.\.) [NC,OR]
RewriteCond %{QUERY_STRING} (eval\(|base64_|concat\() [NC]
RewriteRule ^ - [F,L]

# User agents suspects
RewriteCond %{HTTP_USER_AGENT} (libwww-perl|BBBike|wget|HTTrack|python-requests) [NC]
RewriteRule ^ - [F,L]

# Désactiver indexation
Options -Indexes

# Charset
AddDefaultCharset UTF-8
