{
  "openapi": "3.1.0",
  "info": {
    "title": "lavision API",
    "version": "0.1.0",
    "description": "Socle technique M1. Aucune route métier publique n’est exposée avant l’authentification et les contrôles RBAC."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "tags": [
          "Système"
        ],
        "responses": {
          "200": {
            "description": "Réponse conforme au contrat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": [
          "Système"
        ],
        "responses": {
          "200": {
            "description": "Réponse conforme au contrat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL ne répond pas.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "operationId": "getVersion",
        "tags": [
          "Système"
        ],
        "responses": {
          "200": {
            "description": "Réponse conforme au contrat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LivenessResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string",
            "const": "lavision-api"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "additionalProperties": false
      },
      "ReadinessResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ready"
          },
          "service": {
            "type": "string",
            "const": "lavision-api"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "const": "up"
              }
            },
            "required": [
              "database"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "service",
          "checks"
        ],
        "additionalProperties": false
      },
      "VersionResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "const": "lavision-api"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "apiVersion": {
            "type": "string",
            "const": "v1"
          }
        },
        "required": [
          "name",
          "version",
          "apiVersion"
        ],
        "additionalProperties": false
      },
      "ProblemDetails": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "enum": [
              "NOT_FOUND",
              "VALIDATION_ERROR",
              "DATABASE_UNAVAILABLE",
              "INTERNAL_ERROR"
            ]
          },
          "instance": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^\\/.*"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "instance",
          "requestId"
        ],
        "additionalProperties": false
      }
    }
  }
}
